# Host port mapped to container port 8000
PORT=8000

# Server settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database and file persistence
DATA_DIR=/data
DATABASE_PATH=/data/tracker.db

# Path to Google secrets JSON file on host (passed from outside to Docker container)
GOOGLE_SECRETS_PATH=./Auth/secrets.json

# Polling interval in seconds (default: 300 = 5 minutes)
POLL_INTERVAL_SECONDS=300

# Location provider (Google Find My network)
LOCATION_PROVIDER=google_find_my

# Map tile configuration (OpenStreetMap by default)
TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
